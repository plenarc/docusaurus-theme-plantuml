# npm configuration for docusaurus-theme-plantuml
# Removed deprecated settings: verify-deps-before-run, _jsr-registry, package-manager and cache-max
# (pnpm is pinned by "packageManager" in package.json)

# Registry configuration
registry=https://registry.npmjs.org/

# Security settings
audit-level=moderate
fund=false

# Performance settings
prefer-offline=true
